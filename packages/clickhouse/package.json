{
  "name": "@ponder/clickhouse",
  "version": "0.0.0",
  "description": "Finalized ClickHouse analytics sink for Ponder",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/ponder-sh/ponder",
    "directory": "packages/clickhouse"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/_test/**/*",
    "tsconfig.json",
    "LICENSE"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:acceptance": "PONDER_CLICKHOUSE_ACCEPTANCE=1 vitest --run acceptance.test.ts",
    "test:acceptance:bun": "PONDER_CLICKHOUSE_ACCEPTANCE=1 bun test acceptance.test.ts",
    "test:bun": "bun test",
    "test:typecheck": "vitest --typecheck.only",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clickhouse/client": "1.11.0"
  },
  "peerDependencies": {
    "ponder": ">=0.16.6",
    "typescript": ">=5.0.4"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ponder": "workspace:*",
    "tsup": "^8.0.1",
    "vitest": "1.6.1"
  },
  "engines": {
    "node": ">=18.14"
  }
}
