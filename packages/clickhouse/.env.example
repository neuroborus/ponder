# Real ClickHouse HTTP endpoint for acceptance tests. Start the local harness
# with packages/clickhouse/docker-compose.acceptance.yml, then export this value
# in the shell or pass it inline to `pnpm test:acceptance`.
# CLICKHOUSE_URL=http://127.0.0.1:8123

# Optional: Postgres database for delivery integration tests that exercise the
# durable outbox with a real ClickHouse sink.
# DATABASE_URL=postgres://{username}@localhost:5432/{database}
